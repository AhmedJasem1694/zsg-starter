# ── PocketBase ────────────────────────────────────────────────────────────────
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@zane.local
POCKETBASE_ADMIN_PASSWORD=changeme1234

# ── LLM (OpenRouter) ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5   # optional, defaults to claude-sonnet-4-5

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: the server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Leave unset in development and one is generated into .jwt-secret.local.
JWT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development                            # set to "production" in Railway
# LEAVE UNSET unless the browser app is served from a DIFFERENT origin than
# this API. Setting it switches auth cookies to SameSite=none, which is a
# standing CSRF exposure on a same-origin deployment (Express serves the SPA
# itself here). It does not affect CORS enforcement: the allowlist in
# server/lib/corsPolicy.ts is always enforced in production.
FRONTEND_URL=

# Public URL of the app service. Used for links inside emails (approvals,
# reviews, drafts, the monthly report) and for integration webhook callbacks.
# Must be a host that actually resolves: www, not the apex.
APP_URL=https://www.zanelegal.ai

# ── Outbound email ───────────────────────────────────────────────────────────
# Resend is the configured provider and takes precedence over SMTP below.
# Without it: the public contact form stores the enquiry then answers 502 with
# a mailto fallback, approval requests are created but nobody is notified, and
# the scheduled monthly report claims no period so nothing is recorded as sent.
# Key from the Resend dashboard (API Keys). The sending domain must also be
# verified there, or a valid key still returns 403.
# Verify without sending anything:  npm run email:test
RESEND_API_KEY=

# ── SMTP (optional fallback — used only when RESEND_API_KEY is absent) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zanelegal.ai

# ── Scheduled monthly report (optional) ───────────────────────────────────────
# Emails the monthly legal report to each company's configured CFO and GC
# contacts on the 1st, about the month that has just closed. Off unless set to
# on / true / 1 / yes, because it writes to named people and the recipient
# list comes from the approval_contacts table rather than from code.
# Check who would receive one first:
#   npx tsx scripts/send-monthly-report.ts --recipients
MONTHLY_REPORT_SEND=

# ── Inbound email (Mailgun Inbound Routes) ────────────────────────────────────
# Every company gets {slug}@inbox.zanelegal.ai. Users CC / forward / email
# contracts there and Zane handles them. MAILGUN_SIGNING_KEY verifies the
# webhook signature on every inbound POST (Mailgun dashboard → Sending →
# Webhooks → "HTTP webhook signing key"). See README for the Namecheap DNS setup.
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
INBOUND_EMAIL_DOMAIN=inbox.zanelegal.ai

# ── Google Drive integration (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourapp.railway.app/api/integrations/google-drive/callback

# ── SharePoint / Microsoft integration (optional) ─────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://yourapp.railway.app/api/integrations/sharepoint/callback

# ── Companies House (optional — company search enrichment) ────────────────────
COMPANIES_HOUSE_API_KEY=
